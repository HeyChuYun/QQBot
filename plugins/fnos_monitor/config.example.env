ENABLED=true

# fnOS WebSocket 地址。局域网 HTTP 通常为 NAS_IP:5666。
# 如果飞牛强制 HTTPS，可填写 wss://NAS_IP:5667 并将 FNOS_USE_SSL=true。
FNOS_ENDPOINT=192.168.1.10:5666
FNOS_USERNAME=你的飞牛管理员账号
FNOS_PASSWORD=你的飞牛管理员密码
FNOS_USE_SSL=false
FNOS_SKIP_SSL_VERIFY=true

# 开启两步验证后，可改用已经取得的登录凭据；三项必须同时填写。
FNOS_TOKEN=
FNOS_LONG_TOKEN=
FNOS_SECRET=

FNOS_CONNECT_TIMEOUT_SECONDS=10
FNOS_REQUEST_TIMEOUT_SECONDS=15
FNOS_POLL_INTERVAL_SECONDS=60
UPS_MONITOR_ENABLED=true
NOTIFY_ON_RECOVERY=true
FNOS_STATE_FILE=data/state.json
