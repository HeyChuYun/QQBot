ENABLED=true
# 直接填写 Token，不支持 ${GITHUB_TOKEN} 环境变量引用。
GITHUB_TOKEN=
GITHUB_POLL_INTERVAL_SECONDS=300
GITHUB_INCLUDE_LINK=false
GITHUB_STATE_FILE=data/state.json

# Windows 本地运行：使用下面两项。
BROWSER_CHANNEL=msedge
BROWSER_EXECUTABLE=

# Docker 运行：将 BROWSER_CHANNEL 留空，并设置：
# BROWSER_EXECUTABLE=/usr/bin/chromium
FALLBACK_TO_TEXT=true
